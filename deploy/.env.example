# AI Support Delivery — Environment Configuration Example
# Copy to .env and modify as needed

# === App ===
APP_ENV=demo
LOG_LEVEL=INFO

# === Web ===
WEB_PUBLIC_ORIGIN=http://localhost:8080

# === LLM Provider ===
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# === RAG ===
RAG_RETRIEVAL_STRATEGY=fusion
POLICY_MIN_EVIDENCE_SCORE=0.65
POLICY_MIN_VECTOR_SCORE=0.35

# === Vector Store ===
# Options: local | chroma
VECTOR_STORE_PROVIDER=local
# Chroma settings (only used when VECTOR_STORE_PROVIDER=chroma)
CHROMA_PERSIST_PATH=runtime/chroma
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# === Memory System ===
MEMORY_DB_PATH=runtime/memory.db
CONVERSATION_DB_PATH=runtime/conversations.db
CONVERSATION_TTL_HOURS=24

# === Working Memory Slot TTL (minutes) ===
ORDER_SLOT_TTL_MINUTES=1440
RETURN_REASON_SLOT_TTL_MINUTES=60
INTENT_SLOT_TTL_MINUTES=30
LOGISTICS_FACT_TTL_MINUTES=5
RETURN_FACT_TTL_MINUTES=15

# === Observability ===
OBSERVABILITY_DB_PATH=runtime/observability.db
OBSERVABILITY_INCLUDE_ERROR_MESSAGES=false

# === Fault Injection (testing only, keep 0 in production) ===
MOCK_OMS_LATENCY_MS=0
MOCK_OMS_FAILURE_RATE=0
MOCK_TICKET_LATENCY_MS=0
MOCK_TICKET_FAILURE_RATE=0
