# ===== AI Support Delivery 部署环境变量 =====
# 复制本文件为 .env 后填写，.env 已被 .gitignore 忽略，不会提交到仓库。

# DeepSeek 意图分类（可选）。启用后用于意图识别；失败自动回退本地路由。
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=true

# 应用环境：demo 使用本地确定性数据，无需外部密钥即可演示。
APP_ENV=demo

# 前端公网访问来源（CORS）。部署到云服务器后改为：
# http://<服务器公网IP>:8080
# 本地开发保持 http://localhost:8080 即可。
WEB_PUBLIC_ORIGIN=http://localhost:8080

# 本地链路观测。API 默认输出单行 JSON 日志，并将 Trace/Span 保存到 SQLite。
LOG_LEVEL=INFO
OBSERVABILITY_DB_PATH=runtime/observability.db
# 默认不持久化异常消息；仅在确认没有敏感数据的本地诊断环境临时开启。
OBSERVABILITY_INCLUDE_ERROR_MESSAGES=false

# RAG 证据门禁与检索策略。demo 的消融结果支持 fusion；生产接入真实
# reranker 后可改为 fusion_rerank，但必须重新执行 RAG 三套数据集评测。
POLICY_MIN_EVIDENCE_SCORE=0.65
POLICY_MIN_VECTOR_SCORE=0.35
RAG_RETRIEVAL_STRATEGY=fusion

# 短期业务状态。会话是外层保留窗口；各槽位按业务时效独立过期。
CONVERSATION_TTL_HOURS=24
ORDER_SLOT_TTL_MINUTES=1440
RETURN_REASON_SLOT_TTL_MINUTES=60
INTENT_SLOT_TTL_MINUTES=30
LOGISTICS_FACT_TTL_MINUTES=5
RETURN_FACT_TTL_MINUTES=15
