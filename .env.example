# ===== AI Support Delivery 部署环境变量 =====
# 复制本文件为 .env 后填写，.env 已被 .gitignore 忽略，不会提交到仓库。

# DeepSeek 意图分类（可选）。启用后用于意图识别；失败自动回退本地路由。
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=true

# 应用环境：demo 使用本地确定性数据，无需外部密钥即可演示。
APP_ENV=demo

# 前端公网访问来源（CORS）。部署到云服务器后改为：
# http://<服务器公网IP>:8080
# 本地开发保持 http://localhost:8080 即可。
WEB_PUBLIC_ORIGIN=http://localhost:8080
